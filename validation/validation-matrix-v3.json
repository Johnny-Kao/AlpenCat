{
  "schema_version": 3,
  "campaign": "AlpenCat Validation Campaign v3",
  "frozen_at": "2026-10-03",
  "goal": "Maximize useful evidence per provisioned runner",
  "runner_policy": {
    "provision_once": true,
    "build_once": true,
    "quick_sweep_first": true,
    "deep_followup_same_runner": true,
    "local_m5_required": false
  },
  "quick_phase": {
    "repetitions": 1,
    "kernels": ["FIR", "FFT", "Reduction", "Conv2D"],
    "scenarios": ["idle_pre", "mem_bw", "cpu_light", "game_like", "gpu_light", "idle_post"]
  },
  "deep_trigger": {
    "winner_flip_vs_idle": true,
    "static_regret_pct_at_least": 5.0,
    "cpu_gpu_relative_gap_at_most": 0.20,
    "always_repeat": ["idle_pre", "idle_post"]
  },
  "deep_phase": {
    "additional_repetitions": 5,
    "scope": "scenario x kernel-family pairs selected by quick phase"
  },
  "measurement": {
    "host_snapshot_before_and_after_each_scenario": true,
    "per_process_time_l_metrics": true,
    "capture_cpu_memory_process_table": true,
    "verify_campaign_process_cleanup": true
  }
}
